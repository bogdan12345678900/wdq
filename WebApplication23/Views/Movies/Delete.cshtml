@model Movie
@{ ViewData["Title"] = "Видалення"; }

<h1 class="h3">Видалити фільм?</h1>
<p>Ви впевнені, що хочете видалити <strong>@Model.Title</strong> (@Model.Year)?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a class="btn btn-link" asp-action="Index">Скасувати</a>
</form>

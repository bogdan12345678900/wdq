@model Movie
@{ ViewData["Title"] = Model.Title; }

<div class="row">
    <div class="col-md-4 mb-3">
        @if (!string.IsNullOrEmpty(Model.PosterPath))
        {
            <img src="@Model.PosterPath" class="img-fluid rounded" alt="@Model.Title" />
        }
    </div>
    <div class="col-md-8">
        <h1>@Model.Title</h1>
        <p class="text-muted">@Model.Year @(string.IsNullOrEmpty(Model.Genre) ? "" : "· " + Model.Genre)</p>
        <p>@Model.Description</p>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Змінити</a>
        <a class="btn btn-link" asp-action="Index">До списку</a>
    </div>
</div>

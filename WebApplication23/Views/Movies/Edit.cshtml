@model Movie
@{ ViewData["Title"] = "Редагування"; }

<h1 class="h3 mb-3">Редагування: @Model.Title</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PosterPath" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a class="btn btn-link" asp-action="Index">Скасувати</a>
</form>
